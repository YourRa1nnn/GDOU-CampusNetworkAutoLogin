{
  "_说明": "用之前先填下面这几项：portal_host / ac_id / theme 从校园网认证页的地址里找（例：http://10.123.0.1/srun_portal_pc?ac_id=1&theme=pro）；username 是学号；password 是密码。填完保存即可，程序会自动开始工作。这个 _说明 字段程序会忽略，可以删掉。",
  "username": "",
  "password": "",
  "portal_host": "",
  "ac_id": "1",
  "theme": "pro",
  "os_name": "Windows 10",
  "device_name": "Windows",
  "check_interval_seconds": 25,
  "fail_threshold": 3,
  "fast_retry_seconds": 3,
  "internet_probe_url": "http://connect.rom.miui.com/generate_204",
  "probe_timeout_seconds": 6,
  "daily_check_times": ["06:00", "15:30"],
  "catch_up_window_minutes": 120,
  "enable_active_logout": false,
  "retry_backoff_seconds": [5, 15, 60, 300],
  "web_bind": "127.0.0.1",
  "web_port": 8787,
  "log_max_bytes": 1048576,
  "log_keep_files": 3,
  "verbose_console": true
}
